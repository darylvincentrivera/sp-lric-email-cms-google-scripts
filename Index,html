      function toggleEditModal(open) {
        const modal = document.getElementById('edit-modal');
        if (!modal) return;
        if (open) modal.classList.remove('hidden');
        else       modal.classList.add('hidden');
      }

      function toggleCampaignModal(open) {
        const modal = document.getElementById('campaign-modal');
        if (!modal) return;
        if (open) {
          modal.classList.remove('hidden');
          document.getElementById('segments-container').innerHTML  = '';
          document.getElementById('campaign-folder-input').value   = '';
