    <script>
      let segmentCounter = 0;
      let activePickerRowTargetId = null;

      // Safe Base64 encoding/decoding helper that will NEVER crash the thread
      function safeBtoa(str) {
        try {
          if (!str) return '';
          return btoa(encodeURIComponent(str).replace(/%([0-9A-F]{2})/g, function(match, p1) {
            return String.fromCharCode('0x' + p1);
          }));
        } catch(e) {
          console.error("Base64 Encoding Exception handled safely:", e);
          return '';
        }
      }

      function safeAtob(str) {
        try {
          if (!str) return '';
          return decodeURIComponent(atob(str).split('').map(function(c) {
            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
          }).join(''));
        } catch(e) {
          console.error("Base64 Decoding Exception handled safely:", e);
          return '';
        }
      }

      // SAFE INITIALIZATION: Run each system piece isolated so failures don't kill the layout
      document.addEventListener('DOMContentLoaded', () => {
        console.log("DOM fully loaded. Initializing systems...");
        
        // Always make sure UI tabs are functional immediately
        try {
          switchTab('dashboard'); 
        } catch(e) { console.error("Tab switch failed:", e); }

        // Fetch data asynchronously without blocking the UI thread
        setTimeout(() => {
          try { refreshDashboardStats(); } catch(e) { console.error("Stats load failed:", e); }
          try { loadDirectoryTable(); } catch(e) { console.error("Directory load failed:", e); }
          try { loadCampaignsHistoryTable(); } catch(e) { console.error("Campaigns load failed:", e); }
          try { loadSystemSettings(); } catch(e) { console.error("Settings load failed:", e); }
        }, 100);

        // Fail-safe wrapper for Google API frame load
        try {
          if (typeof gapi !== 'undefined') {
            gapi.load('picker', () => { console.log('Google Picker Framework Initialized.'); });
          }
        } catch(e) {
          console.warn("Google API framework skipped or blocked by browser context.");
        }
      });

      // CORE SYSTEM NAVIGATION (Will now always work)
      function switchTab(tabId) {
        console.log("Switching to tab:", tabId);
        
        const tabs = document.querySelectorAll('.tab-content');
        const buttons = document.querySelectorAll('.nav-btn');
        
        if (tabs.length === 0) return;

        // Hide tabs safely
        tabs.forEach(el => el.classList.add('hidden'));
        buttons.forEach(btn => {
          btn.classList.remove('active-nav-btn', 'text-white');
          btn.classList.add('text-slate-400');
        });

        // Show target tab safely
        const targetTab = document.getElementById(`tab-${tabId}`);
        const activeBtn = document.getElementById(`nav-${tabId}`);
        
        if (targetTab) targetTab.classList.remove('hidden');
        if (activeBtn) {
          activeBtn.classList.add('active-nav-btn');
          activeBtn.classList.remove('text-slate-400');
        }

        const titleMap = {
          'dashboard':  'Dashboard Matrix',
          'recipients': 'User Directory Management',
          'campaigns':  'Published Dispatch Records',
          'settings':   'System Configuration'
        };
        
        const titleEl = document.getElementById('page-title');
        if (titleEl) titleEl.innerText = titleMap[tabId] || tabId;
      }

      function refreshDashboardStats() {
        if (typeof google === 'undefined' || !google.script) return;
        google.script.run
          .withFailureHandler(err => { 
            console.error('Stats error:', err); 
            document.getElementById('stat-status').innerText = "Offline Mode";
          })
          .withSuccessHandler(stats => {
            if (!stats) return;
            const pubEl = document.getElementById('stat-published');
            const actEl = document.getElementById('stat-active');
            const statusEl = document.getElementById('stat-status');
            
            if (pubEl) pubEl.innerText = (stats.totalPublished || 0) + " campaigns";
            if (actEl) actEl.innerText = (stats.activeRecipients || 0) + " users";
            if (statusEl) {
              statusEl.innerText = stats.systemStatus || "Operational";
              statusEl.className = `text-3xl font-bold mt-2 ${stats.statusColor || 'text-emerald-400'}`;
            }
          })
          .getDashboardMetrics();
      }

      function loadDirectoryTable() {
        const tableBody = document.getElementById('directory-table');
        if (!tableBody) return;
        tableBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-500 italic">Loading Directory...</td></tr>`;

        if (typeof google === 'undefined' || !google.script) {
          tableBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-rose-400 italic">Dev Mode: Google Engine Unavailable</td></tr>`;
          return;
        }

        google.script.run
          .withFailureHandler(err => {
            tableBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-rose-400 italic">Error loading recipients: ${err.message}</td></tr>`;
          })
          .withSuccessHandler(users => {
            if (!users || users.length === 0) {
              tableBody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-500 italic">No contacts tracked.</td></tr>`;
              return;
            }
            let htmlLines = '';
            users.forEach(user => {
              const isActive  = user.status === 'Active';
              const toggleBg  = isActive ? 'bg-blue-600' : 'bg-slate-700';
              const toggleDot = isActive ? 'translate-x-5' : 'translate-x-0';
              
              // Utilizing safe encoding logic
              const safeName  = safeBtoa(user.name);
              const safeEmail = safeBtoa(user.email);

              htmlLines += `
                <tr class="hover:bg-slate-900/40 transition border-b border-slate-800/40">
                  <td class="p-4 font-medium text-white">${user.name || 'Unknown'}</td>
                  <td class="p-4 text-slate-400">${user.email || 'No Email'}</td>
                  <td class="p-4">
                    <button onclick="handleToggleStatus(${user.rowId}, '${user.status}')"
                      class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent ${toggleBg} transition-colors duration-200 ease-in-out focus:outline-none">
                      <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out ${toggleDot}"></span>
                    </button>
                  </td>
                  <td class="p-4 text-right">
                    <button onclick="openEditModal(${user.rowId}, '${safeName}', '${safeEmail}')"
                      class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium px-2.5 py-1.5 rounded border border-slate-700 transition cursor-pointer">✏️ Edit</button>
                  </td>
                </tr>
              `;
            });
            tableBody.innerHTML = htmlLines;
          })
          .getRecipientList();
      }

      function loadCampaignsHistoryTable() {
        const historyBody = document.getElementById('campaigns-history-table');
        if (!historyBody) return;
        historyBody.innerHTML = `<tr><td colspan="3" class="p-4 text-center text-slate-500 italic">Loading Logs...</td></tr>`;

        if (typeof google === 'undefined' || !google.script) return;

        google.script.run
          .withFailureHandler(err => {
            historyBody.innerHTML = `<tr><td colspan="3" class="p-4 text-center text-rose-400 italic">Error loading campaigns: ${err.message}</td></tr>`;
          })
          .withSuccessHandler(campaigns => {
            if (!campaigns || campaigns.length === 0) {
              historyBody.innerHTML = `<tr><td colspan="3" class="p-4 text-center text-slate-500 italic">No sent campaigns logged.</td></tr>`;
              return;
            }
            let htmlLines = '';
            campaigns.forEach(camp => {
              const safeBody       = camp.htmlBody  || '';
              const safeSubject    = camp.subject   || '';
              const encodedHtml    = safeBtoa(safeBody);
              const encodedSubject = safeBtoa(safeSubject);

              htmlLines += `
                <tr class="hover:bg-slate-900/40 transition border-b border-slate-800/40">
                  <td class="p-4 font-mono text-xs text-slate-400">${camp.timestamp || 'N/A'}</td>
                  <td class="p-4 font-medium text-white">${safeSubject}</td>
                  <td class="p-4 text-right">
                    <button onclick="openCampaignPreviewModal('${encodedSubject}', '${encodedHtml}')"
                      class="text-slate-400 hover:text-blue-400 transition text-md px-2 py-1 cursor-pointer">👁️</button>
                  </td>
                </tr>
              `;
            });
            historyBody.innerHTML = htmlLines;
          })
          .getCampaignList();
      }

      function openCampaignPreviewModal(encodedSubj, encodedHtml) {
        const subject  = safeAtob(encodedSubj);
        const htmlBody = safeAtob(encodedHtml);

        document.getElementById('preview-subject-header').innerText = subject;
        togglePreviewModal(true);

        const bodyStartIndex = htmlBody.indexOf('<body>') + 6;
        const bodyEndIndex   = htmlBody.indexOf('</body>');
        let renderableHTML   = htmlBody;
        if (bodyStartIndex > 5 && bodyEndIndex > 0) {
          renderableHTML = htmlBody.substring(bodyStartIndex, bodyEndIndex);
        }
        document.getElementById('preview-render-dock').innerHTML = renderableHTML;
      }

      function togglePreviewModal(open) {
        const modal = document.getElementById('preview-modal');
        if (!modal) return;
        if (open) {
          modal.classList.remove('hidden');
        } else {
          modal.classList.add('hidden');
          document.getElementById('preview-render-dock').innerHTML = '';
        }
      }

      function extractFolderIdFromPastedLink(inputElement) {
        const rawValue = inputElement.value.trim();
        if (!rawValue || !rawValue.includes("drive.google.com")) return;
        let extractedId = "";
        if (rawValue.includes("/folders/")) {
          extractedId = rawValue.split("/folders/")[1].split("?")[0].split("/")[0];
        } else if (rawValue.includes("id=")) {
          const urlParams = new URLSearchParams(rawValue.split('?')[1]);
          extractedId = urlParams.get('id');
        }
        if (extractedId) inputElement.value = extractedId;
      }

      function launchDrivePickerForSegment(rowId) {
        activePickerRowTargetId = rowId;
        const currentCustomFolderId = document.getElementById('campaign-folder-input').value.trim();

        if (typeof google === 'undefined' || !google.script) {
          alert("Google Server integration unavailable.");
          return;
        }

        google.script.run
          .withSuccessHandler(folderId => {
            google.script.run
              .withSuccessHandler(token => {
                if (typeof google.picker === 'undefined') {
                  alert('Google Workspace Picker layout blocks this request. Please insert your image URL directly into the asset field.');
                  return;
                }
                const view = new google.picker.DocsView(google.picker.ViewId.DOCS)
                  .setMimeTypes("image/png,image/jpeg,image/jpg,image/gif,image/webp")
                  .setParent(folderId);

                const picker = new google.picker.PickerBuilder()
                  .addView(view)
                  .setOAuthToken(token)
                  .setDeveloperKey("AIzaSyCHFEna7aU1nOQ4Qoug-pdEdO0TmAWoJeI")
                  .setAppId("563783763586-e7mt1qh3rdvn458le45mhnaqfju4at5s.apps.googleusercontent.com")
                  .setOrigin("https://script.google.com")
                  .setCallback(pickerSelectionCallback)
                  .setSize(600, 420)
                  .setTitle("Select Graphic Asset Segment")
                  .build();
                picker.setVisible(true);
              })
              .getOAuthToken();
          })
          .getAssetsFolderId(currentCustomFolderId);
      }

      function pickerSelectionCallback(data) {
        if (data.action === google.picker.Action.PICKED) {
          const doc    = data.docs[0];
          const fileId = doc.id;
          if (fileId && activePickerRowTargetId) {
            const inputField = document.getElementById(`segment-img-input-${activePickerRowTargetId}`);
            if (inputField) {
              inputField.value = `https://drive.google.com/thumbnail?id=${fileId}&sz=w800`;
              inputField.classList.add('border-emerald-500', 'bg-emerald-950/20');
              setTimeout(() => {
                inputField.classList.remove('border-emerald-500', 'bg-emerald-950/20');
              }, 1500);
            }
          }
        }
      }

      function processGoogleDriveLinkInput(inputElement) {
        const rawUrl = inputElement.value.trim();
        if (!rawUrl || !rawUrl.includes("drive.google.com")) return;
        let fileId = "";
        if (rawUrl.includes("/file/d/")) {
          const parts = rawUrl.split("/file/d/");
          if (parts[1]) fileId = parts[1].split("/")[0];
        } else if (rawUrl.includes("id=")) {
          const urlParams = new URLSearchParams(rawUrl.split('?')[1]);
          fileId = urlParams.get('id');
        }
        if (fileId) {
          inputElement.value = `https://drive.google.com/thumbnail?id=${fileId}&sz=w800`;
        }
      }

      function appendNewSegmentRow() {
        segmentCounter++;
        const container = document.getElementById('segments-container');
        if (!container) return;
        const rowHTML = `
          <div id="segment-row-${segmentCounter}" data-row-id="${segmentCounter}" class="campaign-segment-row bg-slate-950 border border-slate-800 p-4 rounded-xl space-y-3 relative group">
            <button onclick="removeSegmentRow(${segmentCounter})" class="absolute top-3 right-3 text-slate-600 hover:text-rose-400 text-sm font-bold transition cursor-pointer" title="Remove segment">×</button>
            <div>
              <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-wide mb-1">Image Asset Link Source</label>
              <div class="flex gap-2">
                <input type="text" id="segment-img-input-${segmentCounter}"
                  oninput="processGoogleDriveLinkInput(this)"
                  class="segment-image-input flex-1 bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-500"
                  placeholder="Click select button to choose from Drive...">
                <button onclick="launchDrivePickerForSegment(${segmentCounter})"
                  class="text-xs bg-blue-600 hover:bg-blue-700 text-white font-medium px-3 py-2 rounded-lg transition shrink-0 cursor-pointer flex items-center gap-1 shadow-sm">🖼️ Select from Drive</button>
              </div>
            </div>
            <div class="flex items-center gap-2 pt-1">
              <input type="checkbox" id="check-link-${segmentCounter}" onchange="toggleLinkInput(this)"
                class="segment-checkbox-toggle rounded bg-slate-900 border-slate-800 text-blue-600 focus:ring-0 focus:ring-offset-0 h-4 w-4 cursor-pointer">
              <label for="check-link-${segmentCounter}" class="text-xs text-slate-400 font-medium select-none cursor-pointer">Contain interactive redirection hyperlink?</label>
            </div>
            <div class="link-input-wrapper hidden transition-all duration-150">
              <label class="block text-[11px] font-bold text-emerald-400 uppercase tracking-wide mb-1">Target Action Destination URL</label>
              <input type="text" id="segment-target-input-${segmentCounter}"
                class="segment-target-input w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-xs text-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-500"
                placeholder="https://example.com/landing-page">
            </div>
          </div>
        `;
        container.insertAdjacentHTML('beforeend', rowHTML);
      }

      function removeSegmentRow(id) {
        const row = document.getElementById(`segment-row-${id}`);
        if (row) row.remove();
      }

      function toggleLinkInput(checkboxElement) {
        const parentRow    = checkboxElement.closest('.campaign-segment-row');
        if (!parentRow) return;
        const inputWrapper = parentRow.querySelector('.link-input-wrapper');
        if (!inputWrapper) return;
        if (checkboxElement.checked) {
          inputWrapper.classList.remove('hidden');
        } else {
          inputWrapper.classList.add('hidden');
          const targetInput = inputWrapper.querySelector('.segment-target-input');
          if (targetInput) targetInput.value = '';
        }
      }

      function handleToggleStatus(rowId, status) {
        if (typeof google === 'undefined') return;
        google.script.run
          .withFailureHandler(err => { alert('Toggle failed: ' + err.message); })
          .withSuccessHandler(() => {
            loadDirectoryTable();
            refreshDashboardStats();
          })
          .toggleUserStatus(rowId, status);
      }

      function openEditModal(rowId, base64Name, base64Email) {
        document.getElementById('edit-row-id').value = rowId;
        document.getElementById('edit-name').value   = safeAtob(base64Name);
        document.getElementById('edit-email').value  = safeAtob(base64Email);
        toggleEditModal(true);
      }

      function toggleModal(open) {
        const modal = document.getElementById('user-modal');
        if (!modal) return;
        if (open) {
          modal.classList.remove('hidden');
        } else {
          modal.classList.add('hidden');
          document.getElementById('modal-name').value  = '';
          document.getElementById('modal-email').value = '';
        }
