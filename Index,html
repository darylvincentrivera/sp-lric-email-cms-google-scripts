    <div id="preview-modal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-sm hidden flex items-center justify-center z-50 p-4">
      <div class="bg-slate-900 border border-slate-800 w-full max-w-2xl h-[85vh] flex flex-col rounded-2xl shadow-2xl overflow-hidden">
        <div class="p-4 border-b border-slate-800 bg-slate-950 flex justify-between items-center shrink-0">
          <div class="flex items-center gap-2">
            <span class="text-xs bg-slate-800 text-slate-400 px-2 py-0.5 rounded font-mono">Subject Header</span>
            <h3 id="preview-subject-header" class="text-sm font-semibold text-white"></h3>
          </div>
          <button onclick="togglePreviewModal(false)" class="text-slate-400 hover:text-rose-400 text-xl font-bold p-1 cursor-pointer">×</button>
