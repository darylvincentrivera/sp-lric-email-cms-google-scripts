      function submitNewUser() {
        const name  = document.getElementById('modal-name').value.trim();
        const email = document.getElementById('modal-email').value.trim();
        if (!name || !email) {
          alert('Please enter both a name and a valid email address.');
          return;
        }
        google.script.run
          .withFailureHandler(err => { alert('Failed to add recipient: ' + err.message); })
          .withSuccessHandler(() => {
            toggleModal(false);
            loadDirectoryTable();
            refreshDashboardStats();
          })
          .addNewRecipient(name, email);
      }

      function submitProfileUpdate() {
        const rowId = document.getElementById('edit-row-id').value;
        const name  = document.getElementById('edit-name').value.trim();
        const email = document.getElementById('edit-email').value.trim();
        if (!name || !email) {
          alert('Please enter both a name and a valid email address.');
          return;
        }
        google.script.run
          .withFailureHandler(err => { alert('Update failed: ' + err.message); })
          .withSuccessHandler(() => {
            toggleEditModal(false);
            loadDirectoryTable();
            refreshDashboardStats();
          })
          .updateRecipientDetails(rowId, name, email);
      }

      function loadSystemSettings() {
        if (typeof google === 'undefined') return;
        google.script.run
          .withFailureHandler(err => { console.error('Settings load error:', err); })
          .withSuccessHandler(settings => {
            if (!settings) return;
            if (settings.facebook)  document.getElementById('link-facebook').value  = settings.facebook;
            if (settings.x)         document.getElementById('link-x').value         = settings.x;
            if (settings.instagram) document.getElementById('link-instagram').value = settings.instagram;
            if (settings.linkedin)  document.getElementById('link-linkedin').value  = settings.linkedin;
            if (settings.youtube)   document.getElementById('link-youtube').value   = settings.youtube;
            if (settings.tiktok)    document.getElementById('link-tiktok').value    = settings.tiktok;
            if (settings.website)   document.getElementById('link-website').value   = settings.website;
          })
          .getSystemSettings();
      }

      function commitSettings() {
        const btn = document.getElementById('save-settings-btn');
        if (!btn) return;
        btn.innerText = "⏳ Saving...";

        const payload = {
          'facebook':  document.getElementById('link-facebook').value.trim(),
          'x':         document.getElementById('link-x').value.trim(),
          'instagram': document.getElementById('link-instagram').value.trim(),
          'linkedin':  document.getElementById('link-linkedin').value.trim(),
          'youtube':   document.getElementById('link-youtube').value.trim(),
          'tiktok':    document.getElementById('link-tiktok').value.trim(),
          'website':   document.getElementById('link-website').value.trim()
        };

        google.script.run
          .withFailureHandler(err => {
            btn.innerText = "❌ Save Failed";
            console.error('Settings save error:', err);
            setTimeout(() => { btn.innerText = "💾 Save Network Links"; }, 2500);
          })
          .withSuccessHandler(() => {
            btn.innerText = "✅ Saved Successfully";
            setTimeout(() => { btn.innerText = "💾 Save Network Links"; }, 2000);
          })
          .saveSystemSettings(payload);
      }

      function fireBroadcastCampaign() {
        const btn      = document.getElementById('send-broadcast-btn');
        const subj     = document.getElementById('campaign-subject').value.trim();
        const rowNodes = document.querySelectorAll('.campaign-segment-row');
        if (!subj) {
          alert('Please enter a subject header before dispatching.');
          return;
        }
        if (rowNodes.length === 0) {
          alert('Please add at least one image segment before dispatching.');
          return;
        }

        let inlineTableCellsHTML = '';
        for (let i = 0; i < rowNodes.length; i++) {
          const row        = rowNodes[i];
          const internalId = row.getAttribute('data-row-id');
          const imgField   = document.getElementById(`segment-img-input-${internalId}`);
          const linkToggle = document.getElementById(`check-link-${internalId}`);
          const targetField= document.getElementById(`segment-target-input-${internalId}`);
          const imageUrl  = imgField    ? imgField.value.trim()   : "";
          const hasLink   = linkToggle  ? linkToggle.checked      : false;
          const targetUrl = targetField ? targetField.value.trim(): "";

          if (!imageUrl) {
            alert(`Segment ${i + 1} is missing an image source URL.`);
            return;
          }
          if (hasLink && !targetUrl) {
            alert(`Segment ${i + 1} has a hyperlink enabled but no destination URL provided.`);
            return;
          }

          let cellBody = `<img src="${imageUrl}" alt="Newsletter Image" width="600" style="width:100%;max-width:600px;height:auto;display:block;">`;
          if (hasLink) {
            cellBody = `<a href="${targetUrl}" target="_blank" style="display:block;border:0;text-decoration:none;">${cellBody}</a>`;
          }
          inlineTableCellsHTML += `<tr><td width="600" style="width:600px;padding:0;margin:0;line-height:0;">${cellBody}</td></tr>`;
        }

        const socialConfig = [
          { id: 'link-facebook',  icon: 'https://cdn-icons-png.flaticon.com/512/3128/3128208.png' },
          { id: 'link-x',         icon: 'https://cdn-icons-png.flaticon.com/512/11823/11823292.png' },
          { id: 'link-instagram', icon: 'https://cdn-icons-png.flaticon.com/512/3128/3128212.png' },
          { id: 'link-linkedin',  icon: 'https://cdn-icons-png.flaticon.com/512/3128/3128219.png' },
          { id: 'link-youtube',   icon: 'https://cdn-icons-png.flaticon.com/512/3128/3128307.png' },
          { id: 'link-tiktok',    icon: 'https://cdn-icons-png.flaticon.com/512/3128/3128319.png' }
        ];

        let socialIconsHTML = '';
        socialConfig.forEach(item => {
          const val = document.getElementById(item.id).value.trim();
          if (val) {
            socialIconsHTML += `<a href="${val}" target="_blank" style="text-decoration:none;margin:0 6px;"><img src="${item.icon}" width="28" height="28" style="display:inline-block;border:none;"></a>`;
          }
        });

        const webLink = document.getElementById('link-website').value.trim();
        const webHTML = webLink ? `<div style="margin-top:15px;"><a href="${webLink}" target="_blank" style="font-family:sans-serif;font-size:12px;color:#3b82f6;text-decoration:none;font-weight:bold;">Visit Official Portal</a></div>` : '';
        const footerHTML = (socialIconsHTML || webHTML) ? `
          <tr>
            <td align="center" style="padding:30px 20px;background-color:#f8fafc;border-top:1px solid #e2e8f0;text-align:center;">
              <p style="font-family:sans-serif;font-size:11px;color:#64748b;margin:0 0 12px 0;text-transform:uppercase;font-weight:bold;">Connect with us</p>
              <div>${socialIconsHTML}</div>
              ${webHTML}
            </td>
          </tr>` : '';

        const masterCompiledHtml = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body,table,td,p,a{margin:0;padding:0;}
    body{background-color:#f1f5f9;}
    img{display:block!important;border:0!important;outline:none!important;text-decoration:none!important;}
  </style>
</head>
<body>
  <table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#f1f5f9">
    <tr>
      <td align="center" style="padding:25px 0;">
        <table width="600" border="0" cellpadding="0" cellspacing="0" style="width:600px;border-collapse:collapse;background-color:#ffffff;">
          ${inlineTableCellsHTML}
          ${footerHTML}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>`;

        btn.disabled  = true;
        btn.innerText = '⏳ Processing Queue...';

        google.script.run
          .withFailureHandler(err => {
            alert('Broadcast failed: ' + err.message);
            btn.disabled  = false;
            btn.innerText = '🚀 Execute Bulk Mail Dispatch';
          })
          .withSuccessHandler(count => {
            alert(`✅ Broadcast complete! ${count} message(s) successfully delivered.`);
            toggleCampaignModal(false);
            btn.disabled  = false;
            btn.innerText = '🚀 Execute Bulk Mail Dispatch';
            loadCampaignsHistoryTable();
            refreshDashboardStats();
          })
          .executeBroadcast(subj, masterCompiledHtml);
      }
    </script>
  </body>
</html>
